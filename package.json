{
  "name": "@tangro/actions-i18next",
  "version": "1.1.20",
  "private": true,
  "description": "An action to verify that all i18next keys are translated",
  "main": "lib/main.js",
  "scripts": {
    "build": "rimraf dist lib && tsc && ncc build lib/main.js --minify",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/action.test.cjs",
    "check": "npm run build && npm test",
    "update-readme": "node scripts/update-readme.js",
    "update-dependencies": "npx npm-check-updates -u",
    "version": "npm run build && git add -A",
    "postversion": "npm run update-readme && git add -A && git commit -m \"updated readme\" && git push"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangro/actions-i18next.git"
  },
  "keywords": [
    "actions"
  ],
  "author": "ankri",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@tangro/tangro-github-toolkit": "2.0.0",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.6",
    "@vercel/ncc": "0.45.0",
    "ejs": "7.0.2",
    "rimraf": "6.1.4",
    "typescript": "7.0.2"
  }
}
